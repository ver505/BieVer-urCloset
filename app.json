{
  "expo": {
    "name": "BieVer",
    "slug": "biever",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "biever",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "edgeToEdgeEnabled": true
    },

    "plugins": [
      "expo-router",
      "expo-font"
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}